{
  "manifest_version": 3,
  "name": "Ludy · Uber Fleet local",
  "version": "0.6.8",
  "description": "Lit la Live Map et collecte les rapports d’activité depuis un onglet Uber Rapports séparé vers Ludy local.",
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:4173/*"],
  "optional_host_permissions": ["https://fleethub.uber.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Ludy · Uber Fleet", "default_popup": "popup.html"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:4173"}
}
