[Unit]
Description=Ludy staging - private persistent virtual display
After=network.target

[Service]
Type=simple
User={{USER}}
Group={{USER}}
WorkingDirectory={{STAGING}}
UMask=0077
ExecStartPre={{NODE}} {{STAGING}}/hosting/desktop-auth.mjs
ExecStart=/usr/bin/Xvfb :99 -screen 0 1600x1000x24 -nolisten tcp -auth {{STAGING}}/.local/hosting/Xauthority
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
