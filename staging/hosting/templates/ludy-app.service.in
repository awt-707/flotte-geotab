[Unit]
Description=Ludy staging - local application
Requires=ludy-stack.service
After=ludy-stack.service
PartOf=ludy-stack.service

[Service]
Type=simple
User={{USER}}
Group={{USER}}
WorkingDirectory={{STAGING}}
UMask=0077
Environment=NODE_ENV=production
ExecStart={{NODE}} {{STAGING}}/scripts/serve.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{STAGING}}/.local

[Install]
WantedBy=multi-user.target
