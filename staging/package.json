    "@supabase/supabase-js": "2.118.0",
    "bidi-js": "1.0.3",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.7",
    "leaflet": "1.9.4",
    "pdf-lib": "1.17.1",
    "playwright": "1.64.1",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  }
