{
  "name": "ludy-staging",
  "private": true,
  "description": "Environnement local isole pour Ludy",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "serve": "node scripts/serve.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "migrate:local": "node scripts/migrate-local.mjs",
    "stop": "node scripts/stop.mjs",
    "check": "node scripts/guard.mjs",
    "export:reference": "node scripts/export-reference.mjs",
    "import:reference": "node scripts/import-reference.mjs",
    "geotab:associate": "node scripts/associate-geotab.mjs",
    "uber:reports-browser": "node scripts/uber-reports-browser.mjs",
    "share": "node scripts/share.mjs",
    "host": "node scripts/host.mjs",
    "hosting:prepare": "node hosting/prepare.mjs",
    "hosting:bundle": "node hosting/bundle.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
