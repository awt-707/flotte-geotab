<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Ludy 2.2 (23/11/2026) : l'application est signée avec le « runtime renforcé » (hardened runtime, défaut de Tauri) ; sans ces
     autorisations macOS refuse en silence le micro et la caméra (tchat : messages audio, appels audio et vidéo → NotAllowedError). -->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.device.camera</key>
  <true/>
</dict>
</plist>
